From 31ba0e133043d1eb85aa23d852fc30498c180695 Mon Sep 17 00:00:00 2001
From: Ben Copeland <ben.copeland@linaro.org>
Date: Thu, 12 Nov 2026 00:02:21 +0000
Subject: [PATCH 1/4] clk: rockchip: rk3399: add a 66.28 MHz PLL rate

Add a 66280000 Hz entry (24 MHz / 20 * 1657 / 6 / 5, VCO 1988.4 MHz)
to the RK3399 PLL table. The ZeroMOD 480x1920 bar display advertises a
66.28 MHz pixel clock. rockchip_pll_determine_rate() picks the first
table rate at or below the request, so without this entry it falls to
65 MHz and dw_hdmi-rockchip rejects the mode as MODE_NOCLOCK.

Integer mode is used because a fractional setting for this rate did
not lock.

Signed-off-by: Ben Copeland <ben.copeland@linaro.org>
---
 drivers/clk/rockchip/clk-rk3399.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/drivers/clk/rockchip/clk-rk3399.c b/drivers/clk/rockchip/clk-rk3399.c
index c2b243d7a5e2..cc08baa4e911 100644
--- a/drivers/clk/rockchip/clk-rk3399.c
+++ b/drivers/clk/rockchip/clk-rk3399.c
@@ -99,6 +99,7 @@ static struct rockchip_pll_rate_table rk3399_pll_rates[] = {
 	RK3036_PLL_RATE( 106500000, 1, 71, 4, 4, 1, 0),
 	RK3036_PLL_RATE(  96000000, 1, 64, 4, 4, 1, 0),
 	RK3036_PLL_RATE(  74250000, 2, 99, 4, 4, 1, 0),
+	RK3036_PLL_RATE(  66280000, 20, 1657, 6, 5, 1, 0),
 	RK3036_PLL_RATE(  65000000, 1, 65, 6, 4, 1, 0),
 	RK3036_PLL_RATE(  54000000, 1, 54, 6, 4, 1, 0),
 	RK3036_PLL_RATE(  27000000, 1, 27, 6, 4, 1, 0),
-- 
2.56.1

